{
  "name": "adaptive-coding-soundtrack",
  "displayName": "Adaptive Coding Soundtrack",
  "description": "Local-first adaptive coding music with optional bring-your-own-key AI generation.",
  "version": "0.3.1",
  "publisher": "adaptive-soundtrack",
  "repository": {
    "type": "git",
    "url": "https://github.com/peimengsui/adaptive-coding-soundtrack.git"
  },
  "homepage": "https://github.com/peimengsui/adaptive-coding-soundtrack#readme",
  "bugs": {
    "url": "https://github.com/peimengsui/adaptive-coding-soundtrack/issues"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "extensionKind": [
    "ui"
  ],
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "music",
    "focus",
    "productivity",
    "cursor",
    "ai music"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:adaptiveMusic.start",
    "onCommand:adaptiveMusic.stop",
    "onCommand:adaptiveMusic.togglePause",
    "onCommand:adaptiveMusic.chooseStyle",
    "onCommand:adaptiveMusic.setVolume",
    "onCommand:adaptiveMusic.showCurrentState",
    "onCommand:adaptiveMusic.showPlayer",
    "onCommand:adaptiveMusic.calibrateSensitivity",
    "onCommand:adaptiveMusic.showDiagnostics",
    "onCommand:adaptiveMusic.chooseMusicSource",
    "onCommand:adaptiveMusic.configureProvider",
    "onCommand:adaptiveMusic.testProviderConnection",
    "onCommand:adaptiveMusic.removeProviderCredentials",
    "onCommand:adaptiveMusic.generateCurrentStyle",
    "onCommand:adaptiveMusic.previewGenerationPrompt",
    "onCommand:adaptiveMusic.showGeneratedCache",
    "onCommand:adaptiveMusic.clearGeneratedCache"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "adaptiveMusic.start",
        "title": "Start Session",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.stop",
        "title": "Stop Session",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.togglePause",
        "title": "Pause/Resume",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.chooseStyle",
        "title": "Choose Style",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.setVolume",
        "title": "Set Volume",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.showCurrentState",
        "title": "Show Current State",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.showPlayer",
        "title": "Show Player",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.calibrateSensitivity",
        "title": "Calibrate Sensitivity",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.showDiagnostics",
        "title": "Show Diagnostics",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.chooseMusicSource",
        "title": "Choose Music Source",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.configureProvider",
        "title": "Configure AI Provider",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.testProviderConnection",
        "title": "Test Provider Connection",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.removeProviderCredentials",
        "title": "Remove Provider API Key",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.generateCurrentStyle",
        "title": "Generate and Cache Current Style",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.previewGenerationPrompt",
        "title": "Preview Generation Prompt",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.showGeneratedCache",
        "title": "Show Generated Music Cache",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.clearGeneratedCache",
        "title": "Clear Generated Music Cache",
        "category": "Adaptive Music"
      }
    ],
    "configuration": {
      "title": "Adaptive Coding Soundtrack",
      "properties": {
        "adaptiveMusic.defaultStyle": {
          "type": "string",
          "enum": [
            "ambient",
            "jazz",
            "lofi"
          ],
          "enumDescriptions": [
            "Spacious pads and slow movement",
            "Warm chords with a light walking pulse",
            "Soft beats and mellow harmony"
          ],
          "default": "ambient",
          "description": "Music style selected when a session starts."
        },
        "adaptiveMusic.musicSource": {
          "type": "string",
          "enum": [
            "local",
            "elevenlabs",
            "google-lyria",
            "stability"
          ],
          "enumDescriptions": [
            "Free local procedural audio with no account or network access",
            "ElevenLabs Music v2 using your own paid API access",
            "Google Lyria 3 Pro Preview using your own paid-tier Gemini API key",
            "Stability AI Stable Audio 3 using your own credits"
          ],
          "default": "local",
          "description": "Preferred soundtrack source. Cached remote tracks play automatically; paid generation requires explicit confirmation and cache misses play local procedural audio."
        },
        "adaptiveMusic.generatedTrackDurationSeconds": {
          "type": "number",
          "minimum": 30,
          "maximum": 360,
          "default": 30,
          "description": "Duration requested only after you explicitly confirm Generate and Cache Current Style."
        },
        "adaptiveMusic.generatedCacheSizeMb": {
          "type": "number",
          "minimum": 25,
          "maximum": 2048,
          "default": 250,
          "description": "Maximum disk space for generated MP3 files. Least-recently-used tracks are removed first."
        },
        "adaptiveMusic.remoteRequestTimeoutSeconds": {
          "type": "number",
          "minimum": 10,
          "maximum": 900,
          "default": 300,
          "description": "Maximum time to wait for an explicitly confirmed AI generation request."
        },
        "adaptiveMusic.remoteDailyGenerationLimit": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 1,
          "description": "Maximum explicit remote generation attempts per provider per UTC day. Failed attempts count; cached playback does not. Use 0 for unlimited."
        },
        "adaptiveMusic.customPromptSuffix": {
          "type": "string",
          "default": "",
          "maxLength": 600,
          "description": "Optional musical direction appended to paid generation prompts. Do not include source code, secrets, paths, or terminal content."
        },
        "adaptiveMusic.volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.45,
          "description": "Playback volume from 0 to 1."
        },
        "adaptiveMusic.adaptiveSwitching": {
          "type": "boolean",
          "default": true,
          "description": "Automatically change musical intent with coding state."
        },
        "adaptiveMusic.contextSensitivity": {
          "type": "string",
          "enum": [
            "responsive",
            "balanced",
            "calm"
          ],
          "enumDescriptions": [
            "React faster with fewer signals",
            "Balanced timing and stability",
            "Prefer slower, steadier transitions"
          ],
          "default": "balanced",
          "description": "Local calibration profile for context inference."
        },
        "adaptiveMusic.minimumAdaptiveConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.65,
          "description": "Keep the current track when a non-critical state has lower confidence."
        },
        "adaptiveMusic.idleTimeoutSeconds": {
          "type": "number",
          "minimum": 10,
          "maximum": 3600,
          "default": 120,
          "description": "Seconds without activity before Idle."
        },
        "adaptiveMusic.unfocusedIdleSeconds": {
          "type": "number",
          "minimum": 5,
          "maximum": 600,
          "default": 30,
          "description": "Seconds before Idle while the editor window is unfocused."
        },
        "adaptiveMusic.waitingDetectionSeconds": {
          "type": "number",
          "minimum": 2,
          "maximum": 300,
          "default": 8,
          "description": "Editing pause during a running task before Waiting."
        },
        "adaptiveMusic.terminalAdaptation": {
          "type": "string",
          "enum": [
            "off",
            "longRunningOnly",
            "all"
          ],
          "enumDescriptions": [
            "Ignore terminal execution lifecycle",
            "Adapt while commands run, but cue only long-running completions",
            "Adapt and cue every terminal completion with a known outcome"
          ],
          "default": "longRunningOnly",
          "description": "How shell-integrated terminal executions affect the soundtrack. Command text and output are never read."
        },
        "adaptiveMusic.terminalMinimumDurationSeconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 300,
          "default": 5,
          "description": "Minimum terminal execution duration for a completion or failure cue in long-running-only mode."
        },
        "adaptiveMusic.completionCueCooldownSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 300,
          "default": 20,
          "description": "Minimum time between terminal completion or failure cues."
        },
        "adaptiveMusic.eventCueVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.18,
          "description": "Relative volume of terminal completion and failure cues."
        },
        "adaptiveMusic.deepFocusSeconds": {
          "type": "number",
          "minimum": 15,
          "maximum": 1800,
          "default": 90,
          "description": "Sustained editing before Deep Focus."
        },
        "adaptiveMusic.completedCueSeconds": {
          "type": "number",
          "minimum": 2,
          "maximum": 30,
          "default": 8,
          "description": "Duration of Completed."
        },
        "adaptiveMusic.fadeDurationMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "default": 1400,
          "description": "Crossfade duration."
        },
        "adaptiveMusic.transitionDebounceMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "default": 1500,
          "description": "Stability delay for non-critical context transitions."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node scripts/clean.mjs",
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json && node --check media/player.js",
    "test:unit": "npm run compile && node --test dist/test/*.test.js",
    "test": "npm run test:unit",
    "test:integration": "npm run compile && node dist/integration/runTest.js",
    "verify": "npm run clean && npm run lint && npm run test && npm run package && npm run check:package",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "check:package": "vsce ls --no-dependencies && node scripts/validate-package.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "mocha": "11.3.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.0.5"
  }
}
