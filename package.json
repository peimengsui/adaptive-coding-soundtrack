{
  "name": "adaptive-coding-soundtrack",
  "displayName": "Adaptive Coding Soundtrack",
  "description": "Local-first music that adapts to your coding flow.",
  "version": "0.2.0",
  "publisher": "adaptive-soundtrack",
  "repository": {
    "type": "git",
    "url": "https://github.com/peimengsui/adaptive-coding-soundtrack.git"
  },
  "homepage": "https://github.com/peimengsui/adaptive-coding-soundtrack#readme",
  "bugs": {
    "url": "https://github.com/peimengsui/adaptive-coding-soundtrack/issues"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "extensionKind": [
    "ui"
  ],
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "music",
    "focus",
    "productivity",
    "cursor"
  ],
  "activationEvents": [
    "onCommand:adaptiveMusic.start",
    "onCommand:adaptiveMusic.stop",
    "onCommand:adaptiveMusic.togglePause",
    "onCommand:adaptiveMusic.chooseStyle",
    "onCommand:adaptiveMusic.setVolume",
    "onCommand:adaptiveMusic.showCurrentState",
    "onCommand:adaptiveMusic.showPlayer",
    "onCommand:adaptiveMusic.calibrateSensitivity",
    "onCommand:adaptiveMusic.showDiagnostics"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "adaptiveMusic.start",
        "title": "Start Session",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.stop",
        "title": "Stop Session",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.togglePause",
        "title": "Pause/Resume",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.chooseStyle",
        "title": "Choose Style",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.setVolume",
        "title": "Set Volume",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.showCurrentState",
        "title": "Show Current State",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.showPlayer",
        "title": "Show Player",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.calibrateSensitivity",
        "title": "Calibrate Sensitivity",
        "category": "Adaptive Music"
      },
      {
        "command": "adaptiveMusic.showDiagnostics",
        "title": "Show Diagnostics",
        "category": "Adaptive Music"
      }
    ],
    "configuration": {
      "title": "Adaptive Coding Soundtrack",
      "properties": {
        "adaptiveMusic.defaultStyle": {
          "type": "string",
          "enum": [
            "ambient",
            "jazz",
            "lofi"
          ],
          "enumDescriptions": [
            "Spacious pads and slow movement",
            "Warm chords with a light walking pulse",
            "Soft beats and mellow harmony"
          ],
          "default": "ambient",
          "description": "Music style selected when a session starts."
        },
        "adaptiveMusic.volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.45,
          "description": "Playback volume from 0 to 1."
        },
        "adaptiveMusic.adaptiveSwitching": {
          "type": "boolean",
          "default": true,
          "description": "Automatically change musical intent with coding state."
        },
        "adaptiveMusic.contextSensitivity": {
          "type": "string",
          "enum": [
            "responsive",
            "balanced",
            "calm"
          ],
          "enumDescriptions": [
            "React faster with fewer signals",
            "Balanced timing and stability",
            "Prefer slower, steadier transitions"
          ],
          "default": "balanced",
          "description": "Local calibration profile for context inference."
        },
        "adaptiveMusic.minimumAdaptiveConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.65,
          "description": "Keep the current track when a non-critical state has lower confidence."
        },
        "adaptiveMusic.idleTimeoutSeconds": {
          "type": "number",
          "minimum": 10,
          "maximum": 3600,
          "default": 120,
          "description": "Seconds without activity before Idle."
        },
        "adaptiveMusic.unfocusedIdleSeconds": {
          "type": "number",
          "minimum": 5,
          "maximum": 600,
          "default": 30,
          "description": "Seconds before Idle while the editor window is unfocused."
        },
        "adaptiveMusic.waitingDetectionSeconds": {
          "type": "number",
          "minimum": 2,
          "maximum": 300,
          "default": 8,
          "description": "Editing pause during a running task before Waiting."
        },
        "adaptiveMusic.deepFocusSeconds": {
          "type": "number",
          "minimum": 15,
          "maximum": 1800,
          "default": 90,
          "description": "Sustained editing before Deep Focus."
        },
        "adaptiveMusic.completedCueSeconds": {
          "type": "number",
          "minimum": 2,
          "maximum": 30,
          "default": 8,
          "description": "Duration of Completed."
        },
        "adaptiveMusic.fadeDurationMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "default": 1400,
          "description": "Crossfade duration."
        },
        "adaptiveMusic.transitionDebounceMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "default": 1500,
          "description": "Stability delay for non-critical context transitions."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node scripts/clean.mjs",
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json && node --check media/player.js",
    "test:unit": "npm run compile && node --test dist/test/*.test.js",
    "test": "npm run test:unit",
    "test:integration": "npm run compile && node dist/integration/runTest.js",
    "verify": "npm run clean && npm run lint && npm run test && npm run package && npm run check:package",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "check:package": "vsce ls --no-dependencies && node scripts/validate-package.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "mocha": "11.3.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.0.5"
  }
}
